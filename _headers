/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), microphone=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self' mailto:; img-src 'self' data: https://images.shincabinet.com; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'none'; font-src 'self'; upgrade-insecure-requests

/config/*
  Cache-Control: public, max-age=0, must-revalidate

/assets/js/content.js
  Cache-Control: public, max-age=0, must-revalidate

/assets/js/site.js
  Cache-Control: public, max-age=0, must-revalidate

/assets/css/styles.css
  Cache-Control: public, max-age=0, must-revalidate

/assets/images/*
  Cache-Control: public, max-age=0, must-revalidate

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/assets/js/theme.js
  Cache-Control: public, max-age=0, must-revalidate
